// BalSanskar data model.
//
// Shape of the domain: Uttar Pradesh -> District -> Block -> School -> Teachers.
// Everything a school produces (activities, achievements) hangs off the school and
// carries denormalised districtId/blockId so that district- and block-level
// reporting is a single indexed scan rather than a three-table join over
// ~130,000 schools.
//
// Privacy stance: the only personal data held about a child is a name, class,
// gender, guardian name and an optional guardian phone. No Aadhaar, no address,
// no caste, no religion, no date of birth (year only), no biometrics.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations (mirrored in packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  STATE_ADMIN
  DISTRICT_ADMIN
  BLOCK_ADMIN
  PRINCIPAL
  TEACHER
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SchoolType {
  PRIMARY
  UPPER_PRIMARY
  COMPOSITE
  KASTURBA_GANDHI
  OTHER
}

enum ClassLevel {
  BALVATIKA
  CLASS_1
  CLASS_2
  CLASS_3
  CLASS_4
  CLASS_5
  CLASS_6
  CLASS_7
  CLASS_8
}

enum ActivityCategory {
  CLASSROOM_INNOVATION
  LEARNING_OUTCOME
  SPORTS
  ARTS_AND_CULTURE
  SCIENCE_AND_MATH
  READING_AND_LIBRARY
  COMMUNITY_ENGAGEMENT
  INFRASTRUCTURE_IMPROVEMENT
  HEALTH_AND_NUTRITION
  DIGITAL_LEARNING
  TEACHER_DEVELOPMENT
  ENROLMENT_DRIVE
  OTHER
}

enum ActivityStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum VisibilityLevel {
  SCHOOL
  BLOCK
  DISTRICT
  STATE
  PUBLIC
}

enum AchievementCategory {
  ACADEMIC
  SPORTS
  ARTS
  SCIENCE
  LITERATURE
  SOCIAL_SERVICE
  ATTENDANCE
  OTHER
}

enum AchievementLevel {
  SCHOOL
  CLUSTER
  BLOCK
  DISTRICT
  STATE
  NATIONAL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// The government programmes a school's work can count towards. Mirrored in
/// packages/shared/src/schemes.ts.
enum Scheme {
  NIPUN_BHARAT
  READING_CAMPAIGN
  PM_POSHAN
  KAYAKALP
  MISSION_SHAKTI
  SWACHH_VIDYALAYA
  SCHOOL_CHALO
  DIGITAL_LEARNING
  KHELO_AND_HEALTH
  SCIENCE_AND_MATH
  COMMUNITY_PARTICIPATION
  TEACHER_DEVELOPMENT
  NONE
}

/// What a village can actually give a school. See contracts/village.ts.
enum NeedKind {
  MATERIAL
  REPAIR
  VOLUNTEER_TIME
  EVENT_SUPPORT
  ENROLMENT_HELP
  OTHER
}

enum NeedStatus {
  OPEN
  PROMISED
  MET
  WITHDRAWN
}

enum HabitationKind {
  VILLAGE
  HAMLET
  WARD
  WORKSITE
  MIGRANT_SETTLEMENT
  OTHER
}

enum MediaKind {
  IMAGE
  DOCUMENT
}

enum OtpPurpose {
  LOGIN
  REGISTRATION
  PHONE_CHANGE
}

/// Whether a school has been confirmed by the block office. A school that has
/// not been can hold nothing: no students, no activities, no uploads.
enum SchoolStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

/// How much of a school's escalated work gets a second pair of eyes at the
/// block. A school earns lighter oversight by having a clean record, and loses
/// it the moment something is returned. See docs/integrity.md.
enum TrustTier {
  NEW
  STANDARD
  TRUSTED
  WATCH
}

enum ClaimStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

/// The gate between a school's own record and everyone else's view of it.
enum ClearanceState {
  /// The activity stays at school visibility; nothing to clear.
  NOT_REQUIRED
  /// Waiting for the head teacher's attestation.
  AWAITING_ATTESTATION
  /// Attested and waiting for a block officer.
  AWAITING_BLOCK
  /// Attested, unflagged, and not drawn in the sample.
  AUTO_CLEARED
  /// A block officer confirmed it.
  CLEARED
  /// A block officer sent it back.
  RETURNED
}

// ---------------------------------------------------------------------------
// Administrative geography
// ---------------------------------------------------------------------------

model District {
  id       String  @id @default(cuid())
  /// Official UP district code, e.g. "09" prefixed series used by the department.
  code     String  @unique
  nameHi   String
  nameEn   String
  division String?

  blocks       Block[]
  schools      School[]
  users        User[]
  activities   Activity[]
  achievements Achievement[]
  needs        SchoolNeed[]
  smcMeetings  SmcMeeting[]
  surveys      HabitationSurvey[]
  claims       SchoolClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nameEn])
  @@map("districts")
}

model Block {
  id         String   @id @default(cuid())
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  code       String
  nameHi     String
  nameEn     String

  schools      School[]
  users        User[]
  activities   Activity[]
  achievements Achievement[]
  needs        SchoolNeed[]
  smcMeetings  SmcMeeting[]
  surveys      HabitationSurvey[]
  claims       SchoolClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([districtId, code])
  @@index([districtId])
  @@map("blocks")
}

model School {
  id            String     @id @default(cuid())
  /// UDISE+ code, 11 digits. The nationally recognised identifier for the school.
  udiseCode     String     @unique
  nameHi        String
  nameEn        String?
  type          SchoolType @default(PRIMARY)
  blockId       String
  block         Block      @relation(fields: [blockId], references: [id], onDelete: Restrict)
  /// Denormalised from block, kept in step by the application layer, so that
  /// district reporting never has to join through blocks.
  districtId    String
  district      District   @relation(fields: [districtId], references: [id], onDelete: Restrict)
  villageOrWard String?
  latitude      Float?
  longitude     Float?
  contactPhone  String?
  isActive      Boolean    @default(true)

  /// A school claimed by a head teacher starts here and can hold nothing until
  /// the block office confirms it. Schools loaded from a UDISE export are
  /// created ACTIVE.
  status SchoolStatus @default(ACTIVE)

  /// Drives how much of this school's escalated work a block officer sees.
  trustTier TrustTier @default(NEW)
  /// Counters behind the tier, maintained when an activity clears or returns.
  clearedCount  Int       @default(0)
  returnedCount Int       @default(0)
  lastReturnedAt DateTime?

  users        User[]
  enrolments   ClassEnrolment[]
  needs        SchoolNeed[]
  smcMeetings  SmcMeeting[]
  surveys      HabitationSurvey[]
  activities   Activity[]
  achievements Achievement[]
  claims       SchoolClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockId])
  @@index([districtId])
  @@index([nameHi])
  @@index([status])
  @@map("schools")
}

/// Something the school needs that a village could provide.
///
/// No money passes through the platform and no amount is ever recorded: a need
/// is met when the head teacher says somebody turned up and did the thing.
/// Handling money would bring payment regulation, an audit duty, and — far
/// worse for a school — the suspicion that somebody is collecting.
model SchoolNeed {
  id       String     @id @default(cuid())
  schoolId String
  school   School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  blockId    String
  block      Block    @relation(fields: [blockId], references: [id], onDelete: Restrict)
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  kind        NeedKind
  status      NeedStatus   @default(OPEN)
  title       String
  detail      String?
  quantity    Int?
  classLevels ClassLevel[]

  /// How the helper chose to be named, typed by the head teacher after a
  /// conversation. Not an account and never a contact detail: this platform is
  /// not a directory of villagers and must not become one.
  helperCredit String?
  metOn        DateTime? @db.Date

  createdById String
  createdBy   User   @relation("NeedCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
  @@index([blockId, status])
  @@index([districtId, status])
  @@map("school_needs")
}

/// A meeting of the School Management Committee, which the RTE Act requires
/// every government school to have and which is three-quarters parents.
///
/// Counts of who attended rather than a list of who they were. The committee's
/// authority is already public; its members' identities are not this platform's
/// to publish.
model SmcMeeting {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  blockId    String
  block      Block    @relation(fields: [blockId], references: [id], onDelete: Restrict)
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  heldOn         DateTime @db.Date
  membersPresent Int
  parentsPresent Int
  womenPresent   Int
  decisions      String
  raisedWithBlock String?

  recordedById String
  recordedBy   User   @relation("SmcRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([schoolId, heldOn])
  @@index([blockId, heldOn])
  @@map("smc_meetings")
}

/// A hamlet walked in search of children who are not in school.
///
/// Counts, never a child. The DPDP Act forbids tracking or monitoring a child
/// outright and no consent unlocks it; the school already holds the names
/// lawfully in the register it has always kept. What nobody can see today is
/// which hamlets have been walked and whether anybody went back, and that is
/// exactly what a count answers.
model HabitationSurvey {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  blockId    String
  block      Block    @relation(fields: [blockId], references: [id], onDelete: Restrict)
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  habitationName    String
  kind              HabitationKind @default(HAMLET)
  surveyedOn        DateTime       @db.Date
  householdsVisited Int
  childrenFound     Int
  childrenEnrolled  Int
  /// Named because they are volunteering an afternoon and the credit is the
  /// point — a hamlet nobody will own is a hamlet nobody surveys.
  surveyedBy        String
  note              String?

  recordedById String
  recordedBy   User   @relation("SurveyRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, habitationName, surveyedOn])
  @@index([blockId, surveyedOn])
  @@index([districtId, surveyedOn])
  @@map("habitation_surveys")
}

/// How many children are on the register in each class.
///
/// The whole of what this platform knows about a school's children. There is no
/// child record and there will not be one: see docs/data-protection.md. A count
/// is enough to notice a school reporting more participants than it teaches, and
/// enough for every return the department asks for.
model ClassEnrolment {
  id         String     @id @default(cuid())
  schoolId   String
  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classLevel ClassLevel
  enrolled   Int
  /// The date the register was read, so an officer can ask about a discrepancy.
  asOn       DateTime   @db.Date

  updatedById String?
  updatedBy   User?   @relation("EnrolmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, classLevel])
  @@map("class_enrolments")
}

/// A head teacher's claim on a school, waiting for the block office.
///
/// A school is never created by a user; it is claimed against its UDISE code
/// and confirmed by the officer who knows the schools in that block by name.
/// See docs/integrity.md.
model SchoolClaim {
  id        String      @id @default(cuid())
  udiseCode String
  status    ClaimStatus @default(PENDING)

  /// The school this claim resolved to. Set on verification — either an
  /// existing register entry or one created at that moment.
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  /// Where the claimant says the school is. Routes the claim to an officer.
  blockId    String
  block      Block    @relation(fields: [blockId], references: [id], onDelete: Restrict)
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  proposedNameHi String
  proposedNameEn String?
  proposedType   SchoolType @default(PRIMARY)
  villageOrWard  String?

  /// The claimant. Their phone is verified by one-time code before the claim
  /// exists, so a claim always traces to a number.
  claimantName         String
  claimantPhone        String
  claimantDesignation  String?
  claimantEmployeeCode String?

  /// Storage key of a photograph of the school board, if the claimant sent one.
  evidenceKey String?

  reviewedById String?
  reviewedBy   User?     @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  /// A claim that nobody acts on frees the code again rather than locking a
  /// school out for good.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockId, status])
  @@index([districtId, status])
  @@index([udiseCode])
  @@index([claimantPhone])
  @@map("school_claims")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id     String     @id @default(cuid())
  /// E.164, always +91XXXXXXXXXX. Doubles as the login identifier for teachers.
  phone  String     @unique
  email  String?    @unique
  /// scrypt hash. Null for teachers, who authenticate by one-time code only.
  passwordHash String?
  fullName     String
  role         UserRole   @default(TEACHER)
  status       UserStatus @default(PENDING_APPROVAL)
  designation  String?
  employeeCode String?

  /// Administrative reach. Which of these are required depends on the role and
  /// is enforced in the application layer (see shared/rbac.requiredScopeFields).
  schoolId   String?
  school     School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  blockId    String?
  block      Block?    @relation(fields: [blockId], references: [id], onDelete: Restrict)
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?   @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[] @relation("UserApprovals")
  approvedAt   DateTime?
  statusReason String?

  lastLoginAt DateTime?
  /// Set when an administrator creates the account, cleared once the user picks
  /// their own password.
  mustSetPassword Boolean @default(false)

  authoredActivities   Activity[]    @relation("ActivityAuthor")
  reviewedActivities   Activity[]    @relation("ActivityReviewer")
  attestedActivities   Activity[]    @relation("ActivityAttestor")
  clearedActivities    Activity[]    @relation("ActivityClearance")
  reviewedClaims       SchoolClaim[] @relation("ClaimReviewer")
  updatedEnrolments    ClassEnrolment[] @relation("EnrolmentUpdatedBy")
  createdNeeds         SchoolNeed[]     @relation("NeedCreatedBy")
  recordedSmcMeetings  SmcMeeting[]     @relation("SmcRecordedBy")
  recordedSurveys      HabitationSurvey[] @relation("SurveyRecordedBy")
  creditedAchievements Achievement[] @relation("AchievementCredited")
  createdAchievements  Achievement[] @relation("AchievementCreatedBy")
  verifiedAchievements Achievement[] @relation("AchievementVerifiedBy")
  appreciations        Appreciation[]
  refreshTokens        RefreshToken[]
  auditEvents          AuditEvent[]
  uploads              MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([blockId])
  @@index([districtId])
  @@index([status, role])
  @@map("users")
}

/// One-time codes for phone login and registration.
///
/// The code itself is never stored; only a salted hash. Rows are kept after use
/// so that resend throttling and abuse investigation have something to read.
model OtpChallenge {
  id          String     @id @default(cuid())
  phone       String
  codeHash    String
  purpose     OtpPurpose
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  requestIp   String?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// Refresh tokens, stored hashed, grouped into a "family" per device.
///
/// Reuse of an already-rotated token is treated as theft: the whole family is
/// revoked, which logs that device out rather than letting an attacker ride
/// along silently.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Children
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// The work of the school
// ---------------------------------------------------------------------------

model Activity {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  blockId     String
  block       Block            @relation(fields: [blockId], references: [id], onDelete: Restrict)
  districtId  String
  district    District         @relation(fields: [districtId], references: [id], onDelete: Restrict)

  authorId String
  author   User   @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  title            String
  description      String
  learningOutcome  String?
  category         ActivityCategory
  occurredOn       DateTime         @db.Date
  classLevels      ClassLevel[]
  participantCount Int?
  tags             String[]
  /// The government programmes this work counts towards, so a block officer's
  /// monthly scheme-wise return assembles itself instead of being typed up.
  schemes          Scheme[]  @default([])

  status              ActivityStatus   @default(DRAFT)
  visibility          VisibilityLevel  @default(SCHOOL)
  requestedVisibility VisibilityLevel?
  submittedAt         DateTime?
  publishedAt         DateTime?

  reviewedById    String?
  reviewedBy      User?     @relation("ActivityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  // --- Leaving the school -------------------------------------------------
  // Work that stays at SCHOOL visibility needs none of this. Anything above it
  // passes the gate described in docs/integrity.md.

  /// The head teacher's named, dated statement that this happened and that the
  /// consent slips are on file. Not a checkbox: it is stored and shown to the
  /// block officer alongside the activity.
  attestedById String?
  attestedBy   User?     @relation("ActivityAttestor", fields: [attestedById], references: [id], onDelete: SetNull)
  attestedAt   DateTime?
  attestationNote String?

  clearance ClearanceState @default(NOT_REQUIRED)
  /// Where the activity is trying to get to. `visibility` is what it has
  /// actually been granted, and never exceeds what has been cleared.
  clearanceTarget VisibilityLevel?
  clearedById     String?
  clearedBy       User?     @relation("ActivityClearance", fields: [clearedById], references: [id], onDelete: SetNull)
  clearedAt       DateTime?
  clearanceNote   String?

  /// Why this is in the block's queue. Higher is more suspicious; the queue is
  /// ordered by it rather than by arrival.
  riskScore Int      @default(0)
  riskFlags String[]
  /// The sentences the assessment wrote, one per flag and in the same order.
  /// Stored rather than regenerated so the specifics an officer needs — the
  /// date, the count, the earlier activity — survive to the queue.
  riskNotes String[] @default([])

  media             ActivityMedia[]
  appreciations     Appreciation[]

  appreciationCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status, occurredOn])
  @@index([blockId, status, occurredOn])
  @@index([districtId, status, occurredOn])
  @@index([authorId, status])
  @@index([status, visibility, publishedAt])
  @@index([category])
  /// The block clearance queue: one indexed scan, ordered by risk.
  @@index([blockId, clearance, riskScore])
  @@map("activities")
}

/// Uploaded bytes, tracked independently of what they are attached to.
///
/// An asset exists from the moment an upload ticket is issued, which means an
/// orphaned upload is visible and sweepable rather than invisible and permanent.
model MediaAsset {
  id          String    @id @default(cuid())
  storageKey  String    @unique
  kind        MediaKind
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?
  checksum    String?
  /// 64-bit difference hash of the image, as 16 hex characters, computed in the
  /// browser before upload. Survives re-compression and resizing, which is what
  /// makes it useful for catching a recycled photograph. Not a security hash.
  perceptualHash String?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Scope of the upload, used to keep one school's files out of another's reach.
  schoolId     String?

  /// Set once the asset is referenced by a record. Unattached assets older than
  /// the sweep window are deleted.
  attachedAt DateTime?

  activityMedia ActivityMedia[]

  createdAt DateTime @default(now())

  /// Generated by PostgreSQL from `perceptualHash`, so the two cannot drift.
  /// Prisma has no `bit` type; the duplicate search reads it through raw SQL,
  /// where `bit_count(a # b)` gives the Hamming distance without an extension.
  perceptualBits Unsupported("bit(64)")?

  @@index([uploadedById])
  @@index([attachedAt])
  @@index([perceptualHash])
  @@map("media_assets")
}

model ActivityMedia {
  id         String     @id @default(cuid())
  activityId String
  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assetId    String
  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  caption    String?
  order      Int        @default(0)

  /// Confirmation that no child's face is identifiable in this frame. Asserted
  /// at upload, again by the head teacher, and seen by the block officer.
  /// Required before the activity can leave its own school.
  noIdentifiableChild   Boolean   @default(false)
  noIdentifiableChildAt DateTime?

  createdAt DateTime @default(now())

  @@unique([activityId, assetId])
  @@index([activityId, order])
  @@map("activity_media")
}

/// Recognition from an officer with oversight. The deliberate alternative to a
/// public "like": attributable, bounded, and impossible to farm.
model Appreciation {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String?
  createdAt  DateTime @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
  @@map("appreciations")
}

model Achievement {
  id         String     @id @default(cuid())
  /// The class the recognised children were in. Never who they were.
  classLevel ClassLevel
  /// How many children from this school were recognised. Usually one.
  childrenRecognised Int @default(1)
  /// The teacher who guided it, because somebody did.
  creditedTeacherId String?
  creditedTeacher   User?   @relation("AchievementCredited", fields: [creditedTeacherId], references: [id], onDelete: SetNull)
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  blockId    String
  block      Block    @relation(fields: [blockId], references: [id], onDelete: Restrict)
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  category    AchievementCategory
  level       AchievementLevel
  title       String
  description String?
  awardedOn   DateTime            @db.Date
  position    Int?
  organiser   String?

  status VerificationStatus @default(PENDING)

  createdById String
  createdBy   User   @relation("AchievementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  verifiedById String?
  verifiedBy   User?     @relation("AchievementVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classLevel])
  @@index([schoolId, status])
  @@index([blockId, status, awardedOn])
  @@index([districtId, status, awardedOn])
  @@map("achievements")
}

// ---------------------------------------------------------------------------
// Oversight
// ---------------------------------------------------------------------------

/// Append-only record of every state change. Written in the same transaction as
/// the change itself wherever the change spans more than one row.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  String?
  action     String
  entityType String
  entityId   String
  /// Scope of the affected entity, so an officer can read the audit trail for
  /// their own district without scanning the whole table.
  schoolId   String?
  blockId    String?
  districtId String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([districtId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}
