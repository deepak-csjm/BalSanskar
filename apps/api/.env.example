# ---------------------------------------------------------------------------
# BalSanskar API
#
# Copy to .env for local development. Every value here is validated at boot by
# src/config.ts; the process refuses to start on a bad or unsafe combination.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL="postgresql://balsanskar:balsanskar@127.0.0.1:5432/balsanskar?schema=public"

# Generate with: openssl rand -base64 48
# Rotating this signs out every session and invalidates every outstanding
# one-time code and file link, which is exactly what a key rotation should do.
JWT_SECRET="change-me-to-a-long-random-value-at-least-32-characters"
JWT_ISSUER=balsanskar
JWT_AUDIENCE=balsanskar-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# One-time codes
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# 'console' prints the code to the log and is refused in production.
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

PUBLIC_API_BASE_URL=http://localhost:4000

# Storage: 'local' needs nothing but a writable directory; 's3' works against
# AWS, MinIO, or any S3-compatible store a state data centre provides.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
SIGNED_URL_TTL_SECONDS=900
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Exact origins, comma separated. A wildcard is refused in production.
CORS_ORIGINS=http://localhost:5173
# Enable only when running behind a proxy you control, so that X-Forwarded-For
# can be trusted for rate limiting and audit records.
TRUST_PROXY=false
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=600

PUBLIC_SHOWCASE_ENABLED=true

# Bootstrap account. Both must be set for the seed script to create it; leave
# them unset on any environment where an administrator already exists.
# SEED_SUPER_ADMIN_PHONE=9876543210
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_SUPER_ADMIN_NAME="Platform Administrator"
