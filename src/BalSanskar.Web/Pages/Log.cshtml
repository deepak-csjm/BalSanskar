@page
@model LogModel
@{ ViewData["Title"] = Model.IsEdit ? "Edit write-up" : "Write up a session"; }

<h1>@(Model.IsEdit ? "Edit write-up" : "Write up a session")</h1>
<p class="sub">
    @(Model.ReusedFrom is null
        ? "Only the theme is required. Fill in what you remember — two minutes is enough."
        : "Started from an earlier session. Change whatever is different this week.")
</p>

@if (!string.IsNullOrEmpty(Model.Error)) { <div class="msg err">@Model.Error</div> }

<form method="post">
    <input type="hidden" asp-for="Input.Id" />

    <label>Date
        <input type="date" asp-for="Input.Date" required />
    </label>
    <span asp-validation-for="Input.Date" class="field-err"></span>

    <label>Theme
        <span class="hint">The value you explored — Honesty, Gratitude, Respect for elders.</span>
        <input type="text" asp-for="Input.Theme" required autofocus maxlength="120" />
    </label>
    <span asp-validation-for="Input.Theme" class="field-err"></span>

    <label>Story or reading
        <span class="hint">What you used to open the theme.</span>
        <textarea asp-for="Input.Story" maxlength="4000"></textarea>
    </label>

    <label>What the children did
        <span class="hint">Craft, role-play, discussion, game.</span>
        <textarea asp-for="Input.Activity" maxlength="4000"></textarea>
    </label>

    <label>At home this week
        <span class="hint">The one thing you want parents to reinforce. This becomes the ask in the parent message.</span>
        <textarea asp-for="Input.HomePractice" maxlength="2000"></textarea>
    </label>

    <label>Note for the next teacher
        <span class="hint">What worked, what fell flat. Never shown to parents.</span>
        <textarea asp-for="Input.TeacherNote" maxlength="4000"></textarea>
    </label>

    <div class="actions">
        <button class="btn" type="submit">Save and see parent message</button>
        <a class="btn secondary" asp-page="/Index">Cancel</a>
    </div>
</form>
